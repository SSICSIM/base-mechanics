# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT (docker-compose)
# Copy this file to .env in the repo root. Docker defaults are pre-filled.
# This is the ONLY .env file you need — docker-compose passes it into every
# service (db, backend, frontend) via `env_file:`.
# ─────────────────────────────────────────────────────────────────────────────

# Backend
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/app
API_CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
# Leave blank to disable the admin token guard (default). Set it, and send it
# as the X-Admin-Token header, once you actually add protected endpoints.
ADMIN_API_TOKEN=

# Postgres (docker-compose only)
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Frontend (Next.js)
# NEXT_PUBLIC_API_BASE_URL is inlined into the browser bundle, so it must be
# reachable from your host machine (the browser is not on the docker network).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
